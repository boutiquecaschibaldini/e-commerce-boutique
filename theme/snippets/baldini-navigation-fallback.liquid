{% if section.settings.menu.links.size == 0 %}{% for block in section.blocks %}{% if block.type == 'navigation_group' %}{% assign group_links = block.settings.menu.links %}
{% if mobile %}{% if block.settings.collections.size > 0 or group_links.size > 0 %}<details><summary>{{ block.settings.title | escape }}</summary>{% for category in block.settings.collections %}<a href="{{ category.url }}">{{ category.title | escape }}</a>{% endfor %}{% for link in group_links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</details>{% elsif block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% endif %}
{% else %}<li>{% if block.settings.collections.size > 0 or group_links.size > 0 %}<details class="b-mega"><summary>{{ block.settings.title | escape }} <span aria-hidden="true">⌄</span></summary><div class="b-mega__panel"><div class="b-container b-mega__columns"><div class="b-mega__intro"><p>{{ block.settings.title | escape }}</p></div><ul>{% for category in block.settings.collections %}<li><a href="{{ category.url }}">{{ category.title | escape }}</a></li>{% endfor %}{% for link in group_links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>
{% for promo in section.blocks %}{% if promo.type == 'mega_menu' and promo.settings.menu_item == block.settings.title %}{% if promo.settings.brand_menu.links.size > 0 %}<div><p class="b-mega__heading">{{ promo.settings.brand_title | escape }}</p><ul>{% for item in promo.settings.brand_menu.links %}<li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>{% endfor %}</ul></div>{% endif %}{% if promo.settings.shop_menu.links.size > 0 %}<div><p class="b-mega__heading">{{ promo.settings.shop_title | escape }}</p><ul>{% for item in promo.settings.shop_menu.links %}<li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>{% endfor %}</ul></div>{% endif %}{% if promo.settings.image %}<a class="b-mega__promo" href="{{ promo.settings.link }}">{{ promo.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '240px', widths: '300,600' }}<strong>{{ promo.settings.title | escape }}</strong></a>{% endif %}{% endif %}{% endfor %}</div></div></details>{% elsif block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>{% endif %}</li>{% endif %}
{% endif %}{% endfor %}{% endif %}