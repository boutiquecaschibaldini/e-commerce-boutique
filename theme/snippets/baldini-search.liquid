<baldini-search data-endpoint="{{ routes.predictive_search_url }}" data-section="baldini-predictive-search">
<form action="{{ routes.search_url }}" method="get" role="search" class="b-search">
<label class="sr-only" for="BSearch-{{ id }}">Cerca nel catalogo</label>
<input id="BSearch-{{ id }}" type="search" name="q" placeholder="Cerca casco, modello, marca..." autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="BSearchResults-{{ id }}">
<input type="hidden" name="options[prefix]" value="last">
<button aria-label="Cerca" type="submit">{% render 'baldini-icon', name: 'search' %}</button>
</form><div class="b-search__results" id="BSearchResults-{{ id }}" hidden role="listbox" aria-label="Suggerimenti di ricerca"></div><span class="sr-only" role="status" data-search-status></span>
</baldini-search>