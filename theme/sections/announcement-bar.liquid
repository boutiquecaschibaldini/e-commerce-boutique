<div class="b-announcement"><div class="b-container b-announcement__items">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.url != blank %}<a href="{{ block.settings.url }}">{{ block.settings.text | escape }}</a>{% else %}<span>{{ block.settings.text | escape }}</span>{% endif %}</div>{% endfor %}</div></div>
{% schema %}
{
  "name": "Baldini · Promo bar",
  "tag": "section",
  "class": "baldini-section",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Messaggio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Messaggio"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
