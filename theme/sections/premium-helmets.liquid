<div class="b-container b-section"><div class="b-promo {% if section.settings.dark %}b-promo--dark{% endif %}"><div><p class="b-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.title | escape }}</h2><div class="b-description">{{ section.settings.text }}</div>{% if section.settings.end_date != blank %}<baldini-countdown data-end="{{ section.settings.end_date | escape }}" hidden><span data-countdown-output role="timer"></span></baldini-countdown>{% endif %}{% assign promo_url = section.settings.link | default: section.settings.collection.url %}{% if promo_url != blank %}<a class="b-button" href="{{ promo_url }}">{{ section.settings.button | escape }} {% render 'baldini-icon', name: 'arrow' %}</a>{% endif %}</div>{% assign image = section.settings.image | default: section.settings.collection.image %}{% if image %}{{ image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(max-width:749px) 100vw, 50vw', widths: '400,600,900,1200' }}{% endif %}</div></div>
{% schema %}
{
  "name": "Baldini · Premium",
  "tag": "section",
  "class": "baldini-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "LA SELEZIONE BALDINI"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Il prossimo viaggio merita il casco giusto."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Testo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link alternativo"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Pulsante",
      "default": "Scopri la selezione"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Stile scuro",
      "default": false
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "Scadenza ISO 8601",
      "info": "Facoltativa: esempio 2026-12-31T23:59:00+01:00. Nessun countdown senza una data valida."
    }
  ],
  "presets": [
    {
      "name": "Baldini · Premium"
    }
  ]
}
{% endschema %}
