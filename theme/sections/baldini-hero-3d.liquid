{{ 'baldini-hero-3d.css' | asset_url | stylesheet_tag }}
<script src="{{ 'baldini-hero-3d.js' | asset_url }}" defer></script>
<baldini-hero class="b3d" data-viewer="{{ 'baldini-model-viewer.min.js' | asset_url }}">
  <div class="b3d__copy">
    <p class="b3d__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="b3d__description">{{ section.settings.description | escape }}</p>
    <a class="b3d__cta" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 13 13 3M3 3h10v10" stroke="currentColor" stroke-width="1.5"/></svg></a>
    {% if section.settings.second_link != blank %}<a class="b3d__secondary" href="{{ section.settings.second_link }}">{{ section.settings.second_label | escape }}</a>{% endif %}
    <p class="b3d__signature">BOUTIQUE CASCHI BALDINI</p>
  </div>
  <div class="b3d__product">
    <div class="b3d__tabs" role="group" aria-label="Scegli la vista del casco">
      <button type="button" data-mode="spin" aria-pressed="true">Prodotto 360°</button>
      <button type="button" data-mode="model" aria-pressed="false">Modello 3D</button>
    </div>
    <div class="b3d__stage" data-spin tabindex="0" role="group" aria-label="Casco a 360 gradi. Usa le frecce sinistra e destra per ruotarlo.">
      <img src="{{ 'baldini-frame-01.jpg' | asset_url }}" width="640" height="640" alt="Casco nero LS2, vista ruotabile a 360 gradi" fetchpriority="high" draggable="false">
    </div>
    <div class="b3d__stage" data-model hidden>
      <model-viewer src="{% if section.settings.model_url != blank %}{{ section.settings.model_url | escape }}{% else %}{{ 'baldini-casco.glb' | asset_url }}{% endif %}" poster="{{ 'baldini-frame-01.jpg' | asset_url }}" alt="Modello tridimensionale di casco" camera-controls touch-action="pan-y" shadow-intensity="1" exposure="1.2" camera-orbit="-30deg 80deg auto"></model-viewer>
    </div>
    <p class="b3d__hint" data-hint aria-live="polite">Trascina per ruotare · oppure usa le frecce</p>
    <div class="b3d__controls" data-controls>
      <button type="button" data-prev aria-label="Ruota il casco a sinistra">←</button>
      <button type="button" data-reset>Vista iniziale</button>
      <button type="button" data-next aria-label="Ruota il casco a destra">→</button>
    </div>
    <p class="b3d__note" data-note hidden>{% if section.settings.model_url == blank %}Ricostruzione 3D indicativa. Per i dettagli reali consulta la vista Prodotto 360°.{% else %}Trascina per ruotare e avvicina per vedere i dettagli.{% endif %}</p>
    <noscript><p>Per ruotare il casco abilita JavaScript. Puoi comunque esplorare il catalogo.</p></noscript>
  </div>
  <script type="application/json" data-frames>[
    {% for i in (1..48) %}{% assign frame_number = i | prepend: '0' | slice: -2, 2 %}{% assign filename = 'baldini-frame-' | append: frame_number | append: '.jpg' %}{{ filename | asset_url | json }}{% unless forloop.last %},{% endunless %}{% endfor %}
  ]</script>
</baldini-hero>
{% schema %}
{
  "name": "Baldini · Hero 3D",
  "tag": "section",
  "class": "shopify-section--baldini-3d",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "IL TUO PROSSIMO CASCO, DA OGNI ANGOLO"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Cambia prospettiva."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrizione",
      "default": "Esplora il casco a 360° e trova il tuo stile. La tua prossima strada inizia qui."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Testo pulsante",
      "default": "Scopri i caschi jet"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link pulsante"
    },
    {
      "type": "url",
      "id": "model_url",
      "label": "URL modello GLB",
      "info": "Facoltativo: inserisci il link di un modello esatto caricato in Contenuti > File. Se vuoto viene usato il modello indicativo incluso."
    },
    {
      "type": "text",
      "id": "second_label",
      "label": "CTA secondaria",
      "default": "Esplora il catalogo"
    },
    {
      "type": "url",
      "id": "second_link",
      "label": "Link secondario"
    }
  ],
  "presets": [
    {
      "name": "Baldini · Hero 3D"
    }
  ]
}
{% endschema %}